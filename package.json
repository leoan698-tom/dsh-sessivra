{
  "name": "@leoan698-tom/dsh-sessivra",
  "version": "0.3.0-dev.19",
  "description": "DSH Sessivra: native session references, explicit messaging and conversation trees for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.1-rc.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "title": {
    "en": "DSH Sessivra",
    "zh": "DSH Sessivra 协作空间"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CONTEXT.md",
    "docs/ARCHITECTURE.md",
    "docs/OPERATIONS.md",
    "docs/RENAMING.md",
    "docs/TEST_REPORT.md",
    "docs/ACCEPTANCE_CRITERIA.md",
    "docs/COLLABORATION_0_3_DEV15.md",
    "docs/adr",
    "docs/KNOWN_ISSUES.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "npm run build && node --test tests/unit.test.mjs tests/recipient.test.mjs tests/client.test.mjs tests/client-interaction.test.mjs",
    "test:integration": "npm run build && node --test --test-timeout=15000 tests/host.test.mjs tests/new-host.test.mjs tests/storage-contention.test.mjs tests/reply-guidance.test.mjs tests/collaboration.test.mjs tests/progress.test.mjs tests/workflow.test.mjs tests/child-messaging.test.mjs tests/tree-discovery.test.mjs tests/reference-messaging.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:integration"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-reference": "0.2.1-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.5",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-reference": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.5",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "js-yaml": "4.3.2",
    "jsdom": "^26.1.0",
    "react-dom": "^18.3.1",
    "semver": "7.8.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoan698-tom/dsh-sessivra.git"
  },
  "homepage": "https://github.com/leoan698-tom/dsh-sessivra#readme",
  "bugs": {
    "url": "https://github.com/leoan698-tom/dsh-sessivra/issues"
  }
}
